# Copy this file to .env.local
# Leave GEMINI_API_KEY empty to run the demo with labelled mock AI.

GEMINI_API_KEY=
# Example value: gemini-2.0-flash
# The app reads this name from the environment. It is not hardcoded in source.
# /api/improve-description uses these two variables on the server only.
GEMINI_MODEL=

# Supabase Auth for /signup. The anon key is public and is limited by row level security.
# Never put the service role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
